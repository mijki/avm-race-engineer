{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avm-race-engineer.local/contracts/calculated-race-state-v0.schema.json",
  "title": "Calculated Race State v0",
  "description": "DRAFT — NOT IMPLEMENTED — SUBJECT TO CHANGE. Current calculated race state for one session and car.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state_id",
    "session_id",
    "car_id",
    "driver_id",
    "track_id",
    "layout_id",
    "strategy_id",
    "strategy_revision",
    "baseline_strategy_revision",
    "stint_id",
    "calculated_at_utc",
    "capture_time_utc",
    "capture_time_monotonic_ms",
    "sequence",
    "freshness",
    "model",
    "sample_set",
    "telemetry_refs",
    "assumption_ids",
    "explanation_ids",
    "measured_telemetry_summary",
    "derived_current_state",
    "comparison_to_plan",
    "active_recommendation_state",
    "confidence",
    "reason_codes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.-]+)?$"
    },
    "state_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "car_id": {
      "type": "string",
      "minLength": 1
    },
    "driver_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "track_id": {
      "type": "string",
      "minLength": 1
    },
    "layout_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "strategy_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "strategy_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "baseline_strategy_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "stint_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "forecast_snapshot_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "calculated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "capture_time_utc": {
      "type": "string",
      "format": "date-time"
    },
    "capture_time_monotonic_ms": {
      "type": "integer",
      "minimum": 0
    },
    "sequence": {
      "$ref": "#/$defs/sequence"
    },
    "freshness": {
      "$ref": "#/$defs/freshness"
    },
    "model": {
      "$ref": "#/$defs/model"
    },
    "sample_set": {
      "$ref": "#/$defs/sample_set"
    },
    "telemetry_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "assumption_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "explanation_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "measured_telemetry_summary": {
      "$ref": "#/$defs/measured_telemetry_summary"
    },
    "derived_current_state": {
      "$ref": "#/$defs/derived_current_state"
    },
    "comparison_to_plan": {
      "$ref": "#/$defs/comparison_to_plan"
    },
    "active_recommendation_state": {
      "$ref": "#/$defs/recommendation_state"
    },
    "confidence": {
      "$ref": "#/$defs/confidence_summary"
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reason_code"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "reason_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]+$"
    },
    "sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stream_id",
        "sequence_number"
      ],
      "properties": {
        "stream_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence_number": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "age_ms"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "live",
            "degraded",
            "stale",
            "disconnected"
          ]
        },
        "age_ms": {
          "type": "integer",
          "minimum": 0
        },
        "valid_until_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_component",
        "model_family",
        "model_version"
      ],
      "properties": {
        "producer_component": {
          "type": "string",
          "enum": [
            "driver_bridge",
            "relay_server"
          ]
        },
        "model_family": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sample_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_set_id",
        "sample_count",
        "operating_regime"
      ],
      "properties": {
        "sample_set_id": {
          "type": "string",
          "minLength": 1
        },
        "sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "oldest_sample_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "newest_sample_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "operating_regime": {
          "type": "string",
          "enum": [
            "normal_green_running",
            "traffic_affected_running",
            "fuel_saving_running",
            "push_running",
            "wet_running",
            "mixed_conditions",
            "caution_or_slow_zone_running",
            "pit_in_lap",
            "pit_lane",
            "pit_out_lap",
            "incident_or_damaged_running",
            "incomplete_telemetry"
          ]
        },
        "excluded_sample_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "measured_telemetry_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_fuel_l",
        "lap_number",
        "lap_distance_m",
        "normalized_track_position",
        "pit_state",
        "traffic_state",
        "weather_measurement_id"
      ],
      "properties": {
        "current_fuel_l": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "lap_number": {
          "type": "integer",
          "minimum": 0
        },
        "lap_distance_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "normalized_track_position": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "speed_mps": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "current_lap_time_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "pit_state": {
          "type": "string",
          "enum": [
            "on_track",
            "pit_entry",
            "pit_lane",
            "pit_box",
            "pit_exit",
            "garage",
            "unknown"
          ]
        },
        "traffic_state": {
          "type": "string",
          "enum": [
            "clear",
            "approaching",
            "following",
            "in_traffic",
            "blocked",
            "unknown"
          ]
        },
        "ambient_temperature_c": {
          "type": [
            "number",
            "null"
          ]
        },
        "road_temperature_c": {
          "type": [
            "number",
            "null"
          ]
        },
        "rain_intensity_0_to_1": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "track_wetness_0_to_1": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "standing_water_0_to_1": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "weather_measurement_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "derived_current_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fuel_use_per_lap_l",
        "fuel_use_per_km_l",
        "fuel_use_per_minute_l",
        "rolling_valid_pace_s_per_lap",
        "traffic_adjusted_pace_s_per_lap",
        "current_stint_distance_m",
        "stint_progress_ratio",
        "fuel_delta_to_plan_l",
        "pace_delta_to_target_s_per_lap",
        "tyre_degradation_rate_percent_per_lap",
        "distance_to_pit_entry_m",
        "estimated_time_to_pit_entry_s",
        "fuel_laps_remaining",
        "weather_trend",
        "track_condition_trend"
      ],
      "properties": {
        "fuel_use_per_lap_l": {
          "type": [
            "number",
            "null"
          ]
        },
        "fuel_use_per_km_l": {
          "type": [
            "number",
            "null"
          ]
        },
        "fuel_use_per_minute_l": {
          "type": [
            "number",
            "null"
          ]
        },
        "rolling_valid_pace_s_per_lap": {
          "type": [
            "number",
            "null"
          ]
        },
        "traffic_adjusted_pace_s_per_lap": {
          "type": [
            "number",
            "null"
          ]
        },
        "current_stint_distance_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "stint_progress_ratio": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "fuel_delta_to_plan_l": {
          "type": [
            "number",
            "null"
          ]
        },
        "pace_delta_to_target_s_per_lap": {
          "type": [
            "number",
            "null"
          ]
        },
        "tyre_degradation_rate_percent_per_lap": {
          "type": [
            "number",
            "null"
          ]
        },
        "distance_to_pit_entry_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "estimated_time_to_pit_entry_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "fuel_laps_remaining": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "weather_trend": {
          "type": "string",
          "enum": [
            "drying",
            "wetting",
            "stable",
            "worsening_rain",
            "improving_rain",
            "unknown"
          ]
        },
        "track_condition_trend": {
          "type": "string",
          "enum": [
            "drying",
            "wetting",
            "stable",
            "unknown"
          ]
        }
      }
    },
    "comparison_to_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_pace_s_per_lap",
        "target_stint_end_lap",
        "current_reserve_l",
        "strategy_alignment"
      ],
      "properties": {
        "target_pace_s_per_lap": {
          "type": [
            "number",
            "null"
          ]
        },
        "target_stint_end_lap": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "current_reserve_l": {
          "type": [
            "number",
            "null"
          ]
        },
        "strategy_alignment": {
          "type": "string",
          "enum": [
            "on_plan",
            "off_plan",
            "replan_required",
            "unknown"
          ]
        }
      }
    },
    "recommendation_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_call",
        "status",
        "reason_codes"
      ],
      "properties": {
        "primary_call": {
          "type": "string",
          "enum": [
            "on_plan",
            "save_fuel",
            "push",
            "target_pace",
            "box_this_lap",
            "box_in_n_laps",
            "stay_out",
            "extend",
            "shorten_stint",
            "change_tyres",
            "double_stint_tyres",
            "replan_required",
            "waiting_for_valid_data",
            "low_confidence"
          ]
        },
        "secondary_call": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "on_plan",
            "save_fuel",
            "push",
            "target_pace",
            "box_this_lap",
            "box_in_n_laps",
            "stay_out",
            "extend",
            "shorten_stint",
            "change_tyres",
            "double_stint_tyres",
            "replan_required",
            "waiting_for_valid_data",
            "low_confidence",
            null
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "actionable",
            "blocked",
            "advisory"
          ]
        },
        "acknowledgement_required": {
          "type": "boolean"
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reason_code"
          },
          "uniqueItems": true
        }
      }
    },
    "confidence_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall_band",
        "overall_score"
      ],
      "properties": {
        "overall_band": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "blocked"
          ]
        },
        "overall_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
