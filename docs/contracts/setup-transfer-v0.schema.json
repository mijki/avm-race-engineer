{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avm-race-engineer.local/contracts/setup-transfer-v0.schema.json",
  "title": "Setup Transfer v0",
  "description": "DRAFT — NOT IMPLEMENTED — SUBJECT TO CHANGE. F0 setup-transfer contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transfer_id",
    "session_id",
    "metadata",
    "staging_state",
    "file_extension",
    "requires_garage_consent",
    "requires_manual_ingame_load",
    "backup_before_placement",
    "rollback_supported",
    "idempotency_key",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.-]+)?$"
    },
    "transfer_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "setup_id",
        "revision",
        "car_id",
        "track_id",
        "layout_id",
        "filename",
        "checksum",
        "size",
        "engineer",
        "notes",
        "creation_time",
        "compatibility",
        "superseded_setup_id"
      ],
      "properties": {
        "setup_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "car_id": {
          "type": "string",
          "minLength": 1
        },
        "track_id": {
          "type": "string",
          "minLength": 1
        },
        "layout_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "filename": {
          "type": "string",
          "pattern": "^[^/\\\\]+\\.ini$"
        },
        "checksum": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "engineer": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "creation_time": {
          "type": "string",
          "format": "date-time"
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "game_family",
            "car_match_required",
            "track_match_required"
          ],
          "properties": {
            "game_family": {
              "type": "string",
              "minLength": 1
            },
            "car_match_required": {
              "type": "boolean"
            },
            "track_match_required": {
              "type": "boolean"
            }
          }
        },
        "superseded_setup_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "staging_state": {
      "type": "string",
      "enum": [
        "created",
        "validated",
        "staged",
        "offered",
        "backed_up",
        "placed",
        "rolled_back",
        "superseded",
        "rejected",
        "failed"
      ]
    },
    "file_extension": {
      "type": "string",
      "const": ".ini"
    },
    "requires_garage_consent": {
      "const": true
    },
    "requires_manual_ingame_load": {
      "const": true
    },
    "backup_before_placement": {
      "const": true
    },
    "rollback_supported": {
      "type": "boolean"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "description": "Structured setup payload or transfer artifact.",
      "additionalProperties": true
    }
  }
}
